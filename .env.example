APP_NAME=ParkingPro API
DEBUG=true
# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=parkingpro
MONGODB_DB=parkingpro
JWT_SECRET_KEY=cambia-esta-clave-secreta
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["*"]
# Contraseña de los usuarios de ejemplo que crea scripts/init_db.py --seed
SEED_PASSWORD=parkingpro123
ZONA_HORARIA=America/Bogota
RESERVA_PENDIENTE_MINUTOS=15
RESERVA_PENDIENTE_MINUTOS_AFILIADO=60
AFILIADO_PRECIO_MENSUAL=29900
AFILIADO_DESCUENTO_PCT=15
AFILIADO_CUPO_PRIORITARIO_PCT=10
# Política por defecto para socios y parqueaderos nuevos (se copia al crearlos; cambiarla no toca a los existentes)
COMISION_PCT=10
COMISION_PRUEBA_PCT=0
PRUEBA_DIAS=30
LIMITE_DEUDA=500000
DEUDA_DIAS_GRACIA=7
# Opcional: redis://localhost:6379/0 o la URL de Redis Cloud/Upstash (rediss://...)
REDIS_URL=
